// Drops the pencil through gear turning 
void drop() //Trivial 
{ 
  GearMotorLeft.spin(forward, 10, percent); 
  GearMotorRight.spin(forward, 10, percent); 
  wait(0.75, seconds); 
 
  GearMotorLeft.stop(); 
  GearMotorRight.stop(); 
  wait(1, seconds); 
} 
 
// Stop event for bumper: halt all motors 
void stopNow()  //Trivial 
{ 
    MotorLeft.stop(); 
    MotorRight.stop(); 
    GearMotorLeft.stop(); 
    GearMotorRight.stop(); 
 
    Brain.Screen.clearScreen(); 
    Brain.Screen.setCursor(1,1); 
    Brain.Screen.print("Chromabot stopped"); 
 
    Brain.programStop(); 
} 
 
void timeDisplay(double calibrationTime, double alignTime, int numPencil) //Non-trivial (5) 
{ 
  Brain.Screen.clearScreen(); 
 
  // Calibration time 
  Brain.Screen.setCursor(1, 1); 
  Brain.Screen.print("Calibration time: "); 
  Brain.Screen.setCursor(2, 1); 
  Brain.Screen.print("%f sec", calibrationTime); 
 
  // Organizing time 
  Brain.Screen.setCursor(3, 1); 
  Brain.Screen.print("Organizing time: "); 
  Brain.Screen.setCursor(4, 1); 
  Brain.Screen.print("%f sec", alignTime); 
 
  double timePerPencil = (alignTime / numPencil); 
 
  // Average time per pencil 
  Brain.Screen.setCursor(5, 1); 
  Brain.Screen.print("Average time/pencil: "); 
  Brain.Screen.setCursor(6, 1); 
  Brain.Screen.print("%f sec/pencil", timePerPencil); 
} 
 
void dump() //Non-trivial (6) 
{ 
  const int TREAD = 200; 
  const int BOX_LENGTH = 207; 
 
  int speed = 15; 
 
41 
 
 
  Brain.Screen.clearScreen(); 
  Brain.Screen.setCursor(4, 1); 
  Brain.Screen.print("Dumping..."); 
 
  while (MotorRight.position(turns) * TREAD < 3 * BOX_LENGTH) 
  { 
    MotorLeft.spin(forward, speed, percent); 
    MotorRight.spin(forward, speed, percent); 
  } 
 
  MotorLeft.stop(); 
  MotorRight.stop(); 
 
  wait(1, seconds); 
 
  GearMotorLeft.spin(forward, speed, percent); 
  GearMotorRight.spin(reverse, speed, percent); 
 
  wait(6, seconds); 
 
  GearMotorLeft.stop(); 
  GearMotorRight.stop(); 
} 
 
//MAIN FUNCTION STARTS HERE 
int main() 
{ 
  vexcodeInit(); 
  configureAllSensors(); 
 
  //emergency stop 
  Bumper4.pressed(stopNow); 
 
  Brain.Timer.reset(); 
  double pencilWidth = calibrateSize(); 
  double calibrationTime = Brain.Timer.value(); 
  int max = countTools(pencilWidth); 
  
  pressAndRelease(); 
 
  Brain.Timer.reset(); 
  for (int i = 0; i < (max + 3); i++) 
  { 
    alignBox(); 
 
    if (TouchLED1.pressing()) 
    { 
      dump(); 
      Brain.programStop(); 
    } 
 
    drop(); 
  } 
  double alignTime = Brain.Timer.value(); 
  timeDisplay(calibrationTime,alignTime, max); 
 
  // Show favourite colour after sorting 
  //displayFavouriteColour(); 
  wait(10, seconds); 
42 
 
 
 
  Brain.programStop(); 
} 
 
