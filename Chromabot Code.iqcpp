// Determines width of pencils 
double calibrateSize()  //Non-trivial (1) 
{ 
  Brain.Screen.setCursor(1, 1); 
  Brain.Screen.print("Calibration process"); 
 
  // Enter One and wait for touch 
  Brain.Screen.setCursor(3, 1); 
  Brain.Screen.print("Place in one pencil"); 
  pressAndRelease(); 
  int oneDist = Distance2.objectDistance(mm); 
  
  // Enter three and wait for touch 
  Brain.Screen.setCursor(4, 1); 
  Brain.Screen.print("Place in three more"); 
  pressAndRelease(); 
  int fourDist = Distance2.objectDistance(mm); 
 
  // Calculate delta distance and divide by three for width of pencil (estimate) 
  double widthPencil = ((oneDist - fourDist)/3.0); 
 
  return widthPencil; // return width of pencil 
} 
 
// Function for calculating #tools taking width of pencil as parameter 
int countTools(double widthPencil)  //Non-trivial (2) 
{ 
  const int traySize = 145; //the loading tray is 145mm long 
 
  Brain.Screen.setCursor(5, 1); 
  Brain.Screen.print("Place in the rest"); 
  pressAndRelease(); 
 
  int loadedDistance = Distance2.objectDistance(mm); // The distance from sensor to closest 
pencil 
  int occupiedDistance = traySize - loadedDistance; // The distance covered by the pencils 
 
  int amountPencils = (int) ((occupiedDistance / widthPencil) + 0.5); //rounding with +0.5 & 
int casting 
  
  Brain.Screen.setCursor(6, 1); 
  Brain.Screen.print("Estimated Amount:"); 
  Brain.Screen.setCursor(7, 1); 
  Brain.Screen.print("~%d (+/- 1)", amountPencils); 
  return amountPencils; 
} 
 
// Returns an integer value that corresponds with a hue range 
int colorDetect() //Non-trivial (3) 
{ 
  int hue = Optical3.hue(); 
 
  Brain.Screen.clearScreen(); 
 
  // RED (0–18 or 351–360) 
  if (hue < 18 || hue >= 351) 
36 
 
 
  { 
    Brain.Screen.setCursor(1, 1); 
    Brain.Screen.print("RED"); 
    
    Brain.Screen.setCursor(2, 1); 
    Brain.Screen.print("Hue: %d", hue); 
 
    return 1; 
  } 
 
  // ORANGE/YELLOW (18–54) 
  else if (hue < 54) 
  { 
    Brain.Screen.setCursor(1, 1); 
    Brain.Screen.print("ORANGE/YELLOW"); 
    
    Brain.Screen.setCursor(2, 1); 
    Brain.Screen.print("Hue: %d", hue); 
 
    return 2; 
  } 
 
  // GREEN (54–153) 
  else if (hue < 153) 
  { 
    Brain.Screen.setCursor(1, 1); 
    Brain.Screen.print("GREEN"); 
    
    Brain.Screen.setCursor(2, 1); 
    Brain.Screen.print("Hue: %d", hue); 
 
    return 3; 
  } 
 
  // BLUE (153–270) 
  else if (hue < 270) 
  { 
    Brain.Screen.setCursor(1, 1); 
    Brain.Screen.print("BLUE"); 
    
    Brain.Screen.setCursor(2, 1); 
    Brain.Screen.print("Hue: %d", hue); 
 
    return 4; 
  } 
 
  // PURPLE / PINK (270–356) 
  else if (hue < 356) 
  { 
    Brain.Screen.setCursor(1, 1); 
    Brain.Screen.print("PURPLE/PINK"); 
    
    Brain.Screen.setCursor(2, 1); 
    Brain.Screen.print("Hue: %d", hue); 
 
    return 5; 
  } 
 
  Brain.Screen.setCursor(1, 1); 
37 
 
 
  Brain.Screen.print("RED"); 
    
  Brain.Screen.setCursor(2, 1); 
  Brain.Screen.print("Hue: %d", hue); 
 
  return 1; 
} 
 
// Aligns Chromabot to corresponding box 
// Box placement order: red, orange/yellow, green, blue, purple/pink 
void alignBox() //Non-trivial (4) 
{ 
  const int TREAD = 200; //Circumference of motor-encoded wheels 
  const int BOX_LENGTH = 207; //Assuming boxes are stuck next to each other 
 
  int colorInt = colorDetect(); 
  const int speed = 15; 
 
  // Getting to red box 
  if (colorInt == 1) // (1 = red) 
  { 
    while (MotorRight.position(turns) * TREAD < 2 * BOX_LENGTH) // Going to red only from the 
right (since box is leftmost) 
    { 
      if (TouchLED1.pressing()) 
    { 
      dump(); 
      Brain.programStop(); 
    } 
 
      MotorLeft.spin(forward, speed, percent); 
      MotorRight.spin(forward, speed, percent); 
    } 
 
    MotorLeft.stop(); 
    MotorRight.stop(); 
  } 
 
  // Getting to orange/yellow box 
  else if (colorInt == 2 && MotorRight.position(turns) * TREAD > 1 * BOX_LENGTH) // Going to 
orange/yellow from the left 
  { 
    while (MotorRight.position(turns) * TREAD > 1 * BOX_LENGTH) 
    { 
      if (TouchLED1.pressing()) 
      { 
        dump(); 
        Brain.programStop(); 
      } 
 
      MotorLeft.spin(reverse, speed, percent); 
      MotorRight.spin(reverse, speed, percent); 
    } 
 
    MotorLeft.stop(); 
    MotorRight.stop(); 
  } 
 
38 
 
 
  else if (colorInt == 2 && MotorRight.position(turns) * TREAD < 1 * BOX_LENGTH) // Going to 
orange/yellow from the right 
  { 
    while (MotorRight.position(turns) * TREAD < 1 * BOX_LENGTH) 
    { 
      if (TouchLED1.pressing()) 
      { 
        dump(); 
        Brain.programStop(); 
      } 
 
      MotorLeft.spin(forward, speed, percent); 
      MotorRight.spin(forward, speed, percent); 
    } 
 
    MotorLeft.stop(); 
    MotorRight.stop(); 
  } 
 
  // Getting to green box 
  else if (colorInt == 3 && MotorRight.position(turns) * TREAD > 0) // Going to green from the 
left 
  { 
    while (MotorRight.position(turns) * TREAD > 0) 
    { 
      if (TouchLED1.pressing()) 
      { 
        dump(); 
        Brain.programStop(); 
      } 
 
      MotorLeft.spin(reverse, speed, percent); 
      MotorRight.spin(reverse, speed, percent); 
    } 
 
    MotorLeft.stop(); 
    MotorRight.stop(); 
  } 
 
  else if (colorInt == 3 && MotorRight.position(turns) * TREAD < 0) //Going to green from the 
right 
  { 
    while (MotorRight.position(turns) * TREAD < 0) 
    { 
      if (TouchLED1.pressing()) 
      { 
        dump(); 
        Brain.programStop(); 
      } 
 
      MotorLeft.spin(forward, speed, percent); 
      MotorRight.spin(forward, speed, percent); 
    } 
 
    MotorLeft.stop(); 
    MotorRight.stop(); 
  } 
 
  // Getting to blue box 
39 
 
 
  else if (colorInt == 4 && MotorRight.position(turns) * TREAD > -1 * BOX_LENGTH) // Going to 
blue from the left 
  { 
    while (MotorRight.position(turns) * TREAD > -1 * BOX_LENGTH) 
    { 
      if (TouchLED1.pressing()) 
      { 
        dump(); 
        Brain.programStop(); 
      } 
 
      MotorLeft.spin(reverse, speed, percent); 
      MotorRight.spin(reverse, speed, percent); 
    } 
 
    MotorLeft.stop(); 
    MotorRight.stop(); 
  } 
 
  else if (colorInt == 4 && MotorRight.position(turns) * TREAD < -1 * BOX_LENGTH) // Going to 
blue from the right 
  { 
    while (MotorRight.position(turns) * TREAD < -1 * BOX_LENGTH) 
    { 
      if (TouchLED1.pressing()) 
      { 
        dump(); 
        Brain.programStop(); 
      } 
 
      MotorLeft.spin(forward, speed, percent); 
      MotorRight.spin(forward, speed, percent); 
    } 
 
    MotorLeft.stop(); 
    MotorRight.stop(); 
  } 
 
  // Getting to purple/pink box 
  else if (colorInt == 5) // Going to purple/pink box only from the right (since box is 
rightmost) 
  { 
    while (MotorRight.position(turns) * TREAD > -2 * BOX_LENGTH) 
    { 
      if (TouchLED1.pressing()) 
      { 
        dump(); 
        Brain.programStop(); 
      } 
 
      MotorLeft.spin(reverse, speed, percent); 
      MotorRight.spin(reverse, speed, percent); 
    } 
 
    MotorLeft.stop(); 
    MotorRight.stop(); 
  } 
} 
 
